<div id="landing-page" class="relative min-h-screen overflow-hidden bg-[#030711] text-slate-100">
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_18%_22%,rgba(34,211,238,0.14),transparent_30%),radial-gradient(circle_at_78%_28%,rgba(99,102,241,0.16),transparent_32%),radial-gradient(circle_at_55%_90%,rgba(14,165,233,0.09),transparent_38%)]">
  </div>
  <div class="pointer-events-none absolute inset-0 opacity-25 [background-image:linear-gradient(rgba(103,232,249,0.07)_1px,transparent_1px),linear-gradient(90deg,rgba(103,232,249,0.07)_1px,transparent_1px)] [background-size:64px_64px] [mask-image:linear-gradient(to_bottom,black,transparent_82%)]">
  </div>

  <header class="relative z-10 mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-10">
    <div class="flex items-center gap-3">
      <div class="grid size-10 place-items-center rounded-xl border border-cyan-300/25 bg-cyan-300/10 text-cyan-200">
        <.icon name="hero-rocket-launch" class="size-5" />
      </div>
      <div>
        <p class="text-sm font-semibold tracking-[0.18em] text-white">DARKORBIT</p>
        <p class="text-[0.55rem] uppercase tracking-[0.25em] text-cyan-300/60">
          Umbrella prototype
        </p>
      </div>
    </div>
    <.link
      href={if(@current_player, do: ~p"/play", else: ~p"/login")}
      id="launch-client-link"
      class="rounded-xl border border-cyan-300/25 bg-cyan-300/10 px-4 py-2.5 text-xs font-bold text-cyan-100 transition hover:-translate-y-0.5 hover:border-cyan-200/50 hover:bg-cyan-300/15"
    >
      {if(@current_player, do: "Return to sector", else: "Pilot sign in")}
    </.link>
  </header>

  <main class="relative z-10 mx-auto grid min-h-[calc(100vh-6rem)] max-w-7xl items-center gap-14 px-6 pb-20 pt-10 lg:grid-cols-[1.05fr_0.95fr] lg:px-10 lg:pb-28">
    <section>
      <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-emerald-300/20 bg-emerald-300/5 px-3 py-1.5 text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-emerald-200/80">
        <span class="size-1.5 rounded-full bg-emerald-300 shadow-[0_0_10px_rgba(110,231,183,0.8)]">
        </span>
        Sector relay online
      </div>
      <h1 class="max-w-3xl text-5xl font-semibold leading-[0.98] tracking-[-0.045em] text-white sm:text-6xl lg:text-7xl">
        Your first flight starts
        <span class="bg-gradient-to-r from-cyan-200 via-sky-300 to-indigo-300 bg-clip-text text-transparent">
          in sector 1-1.
        </span>
      </h1>
      <p class="mt-7 max-w-2xl text-base leading-8 text-slate-400 sm:text-lg">
        A browser-native multiplayer space client backed by an authoritative Elixir/OTP simulation. Plot a course, watch nearby pilots, and explore the live map without handing gameplay authority to the browser.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <.link
          href={if(@current_player, do: ~p"/play", else: ~p"/login")}
          id="primary-launch-link"
          class="group flex items-center gap-2 rounded-xl bg-cyan-300 px-5 py-3.5 text-sm font-bold text-slate-950 shadow-xl shadow-cyan-500/15 transition hover:-translate-y-0.5 hover:bg-cyan-200 hover:shadow-cyan-400/25"
        >
          Launch browser client
          <.icon
            name="hero-arrow-up-right"
            class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </.link>
        <span class="text-xs text-slate-500">Canvas 2D · Phoenix Channels · Core.World</span>
      </div>
    </section>

    <section class="relative mx-auto w-full max-w-xl" aria-label="Client feature preview">
      <div class="absolute -inset-10 rounded-full bg-cyan-400/5 blur-3xl"></div>
      <div class="relative overflow-hidden rounded-3xl border border-cyan-300/15 bg-slate-950/75 p-3 shadow-2xl shadow-black/50 backdrop-blur-xl">
        <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-slate-800 bg-[#020712]">
          <div class="absolute inset-0 opacity-50 [background-image:radial-gradient(circle,rgba(255,255,255,0.8)_1px,transparent_1.5px)] [background-size:43px_43px]">
          </div>
          <div class="absolute left-[18%] top-[22%] size-1 rounded-full bg-cyan-200 shadow-[0_0_12px_rgba(165,243,252,0.9)]">
          </div>
          <div class="absolute right-[16%] top-[38%] size-1 rounded-full bg-indigo-200 shadow-[0_0_12px_rgba(199,210,254,0.9)]">
          </div>
          <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
            <div class="absolute left-1/2 top-1/2 h-24 w-24 -translate-x-1/2 -translate-y-1/2 rounded-full border border-cyan-300/10">
            </div>
            <svg
              viewBox="0 0 96 72"
              class="w-28 drop-shadow-[0_0_20px_rgba(34,211,238,0.45)]"
              aria-hidden="true"
            >
              <path
                d="M48 5 63 34 88 50 58 47 48 67 38 47 8 50 33 34Z"
                fill="#11243b"
                stroke="#67e8f9"
                stroke-width="2"
              />
              <path d="m48 13 8 27-8 12-8-12Z" fill="#a5f3fc" />
              <path d="m36 49 6 13-9-10Zm24 0-6 13 9-10Z" fill="#60a5fa" />
            </svg>
          </div>
          <div class="absolute inset-x-5 bottom-5 grid grid-cols-3 gap-2">
            <div class="rounded-lg border border-slate-700/70 bg-slate-950/75 p-2 backdrop-blur">
              <p class="text-[0.5rem] uppercase tracking-widest text-slate-500">Hull</p>
              <div class="mt-1.5 h-1 rounded-full bg-slate-800">
                <div class="h-full w-full rounded-full bg-emerald-300"></div>
              </div>
            </div>
            <div class="rounded-lg border border-slate-700/70 bg-slate-950/75 p-2 backdrop-blur">
              <p class="text-[0.5rem] uppercase tracking-widest text-slate-500">Shield</p>
              <div class="mt-1.5 h-1 rounded-full bg-slate-800">
                <div class="h-full w-2/3 rounded-full bg-cyan-300"></div>
              </div>
            </div>
            <div class="rounded-lg border border-slate-700/70 bg-slate-950/75 p-2 backdrop-blur">
              <p class="text-[0.5rem] uppercase tracking-widest text-slate-500">Speed</p>
              <p class="mt-1 font-mono text-[0.6rem] text-slate-300">320 u/s</p>
            </div>
          </div>
        </div>
      </div>
      <div class="relative mt-5 grid grid-cols-3 gap-3 text-center">
        <div class="rounded-xl border border-slate-800 bg-slate-950/50 px-3 py-3">
          <p class="text-lg font-semibold text-white">100ms</p>
          <p class="mt-0.5 text-[0.55rem] uppercase tracking-wider text-slate-500">World tick</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-950/50 px-3 py-3">
          <p class="text-lg font-semibold text-white">20×12k</p>
          <p class="mt-0.5 text-[0.55rem] uppercase tracking-wider text-slate-500">Map units</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-950/50 px-3 py-3">
          <p class="text-lg font-semibold text-white">Live</p>
          <p class="mt-0.5 text-[0.55rem] uppercase tracking-wider text-slate-500">Multiplayer</p>
        </div>
      </div>
    </section>
  </main>
</div>
