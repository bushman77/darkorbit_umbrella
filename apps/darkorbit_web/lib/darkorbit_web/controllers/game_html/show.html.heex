<div
  id="game-client"
  data-socket-token={@socket_token}
  data-map-id="1-1"
  class="relative h-screen min-h-[38rem] overflow-hidden bg-[#02050c] text-slate-100"
>
  <canvas
    id="space-viewport"
    class="absolute inset-0 size-full cursor-crosshair touch-none"
    aria-label="Interactive sector 1-1 space viewport. Left-click an NPC to target it, or left-click and hold empty space to navigate."
  >
    Your browser needs Canvas 2D support to run the space client.
  </canvas>

  <header class="pointer-events-none absolute inset-x-0 top-0 z-10 flex items-start justify-between gap-4 p-4 sm:p-6">
    <div class="pointer-events-auto flex items-center gap-3 rounded-2xl border border-cyan-300/15 bg-slate-950/75 px-4 py-3 shadow-xl shadow-black/30 backdrop-blur-xl">
      <div class="grid size-9 place-items-center rounded-xl bg-cyan-300/10 text-cyan-200">
        <.icon name="hero-rocket-launch" class="size-5" />
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span
            id="connection-indicator"
            class="size-1.5 rounded-full bg-amber-300 shadow-[0_0_10px_rgba(252,211,77,0.8)]"
          >
          </span>
          <p
            id="connection-status"
            class="text-[0.62rem] font-semibold uppercase tracking-[0.25em] text-slate-400"
          >
            Connecting
          </p>
        </div>
        <p class="mt-1 text-sm font-semibold">Sector <span class="text-cyan-200">1-1</span></p>
      </div>
    </div>

    <.form
      for={@logout_form}
      id="pilot-logout-form"
      action={~p"/logout"}
      method="delete"
      class="pointer-events-auto"
    >
      <button
        id="pilot-logout-button"
        type="submit"
        class="flex items-center gap-2 rounded-xl border border-slate-700/80 bg-slate-950/75 px-3.5 py-2.5 text-xs font-semibold text-slate-300 backdrop-blur-xl transition hover:border-rose-300/40 hover:text-rose-200"
      >
        <.icon name="hero-power" class="size-4" />
        <span class="hidden sm:inline">End session</span>
      </button>
    </.form>
  </header>

  <aside
    id="combat-hud"
    aria-label="Combat controls"
    class="absolute right-4 top-24 z-10 w-[min(21rem,calc(100%-2rem))] rounded-2xl border border-orange-300/15 bg-slate-950/80 p-4 shadow-2xl shadow-black/40 backdrop-blur-xl sm:right-6 sm:top-28"
  >
    <div class="flex items-center justify-between gap-3">
      <div>
        <p class="text-[0.58rem] font-semibold uppercase tracking-[0.28em] text-orange-300/65">
          Combat relay
        </p>
        <p id="combat-status" role="status" class="mt-1.5 text-xs text-slate-400">
          Left-click a hostile, then press Space to engage.
        </p>
      </div>
      <div class="grid size-9 shrink-0 place-items-center rounded-xl bg-orange-300/10 text-orange-200">
        <.icon name="hero-bolt" class="size-5" />
      </div>
    </div>

    <div id="combat-target-panel" class="mt-4 hidden border-t border-slate-800/90 pt-4">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="text-[0.55rem] uppercase tracking-[0.2em] text-slate-500">Locked target</p>
          <h2 id="combat-target-name" class="mt-1 text-base font-semibold text-orange-100">—</h2>
          <p
            id="combat-target-state"
            class="mt-0.5 text-[0.62rem] font-semibold tracking-wide text-orange-300/65"
          >
            —
          </p>
        </div>
        <button
          id="combat-clear-target"
          type="button"
          class="rounded-lg border border-slate-700/80 bg-slate-900/70 px-2.5 py-1.5 text-[0.62rem] font-semibold text-slate-400 transition hover:border-orange-300/40 hover:text-orange-100 focus:outline-none focus:ring-2 focus:ring-orange-300/50"
        >
          Clear
        </button>
      </div>

      <div class="mt-3 space-y-2.5">
        <div>
          <div class="mb-1 flex items-center justify-between text-[0.6rem] font-semibold uppercase tracking-[0.13em]">
            <span class="text-emerald-300">Hull</span>
            <span id="combat-target-hull" class="font-mono text-slate-300">—</span>
          </div>
          <div class="h-1.5 overflow-hidden rounded-full bg-slate-800">
            <div
              id="combat-target-hull-bar"
              class="h-full w-0 rounded-full bg-gradient-to-r from-emerald-600 to-emerald-300 transition-[width] duration-200"
            >
            </div>
          </div>
        </div>
        <div>
          <div class="mb-1 flex items-center justify-between text-[0.6rem] font-semibold uppercase tracking-[0.13em]">
            <span class="text-sky-300">Shield</span>
            <span id="combat-target-shields" class="font-mono text-slate-300">—</span>
          </div>
          <div class="h-1.5 overflow-hidden rounded-full bg-slate-800">
            <div
              id="combat-target-shield-bar"
              class="h-full w-0 rounded-full bg-gradient-to-r from-blue-600 to-cyan-300 transition-[width] duration-200"
            >
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4 grid grid-cols-2 gap-2 border-t border-slate-800/90 pt-4">
      <button
        id="combat-target-nearest"
        type="button"
        class="flex items-center justify-center gap-2 rounded-xl border border-slate-700/80 bg-slate-900/70 px-3 py-2.5 text-xs font-semibold text-slate-200 transition hover:-translate-y-0.5 hover:border-orange-300/40 hover:text-orange-100 focus:outline-none focus:ring-2 focus:ring-orange-300/50 active:translate-y-0"
      >
        <.icon name="hero-viewfinder-circle" class="size-4" /> Target nearest
      </button>
      <button
        id="combat-fire"
        type="button"
        class="flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-orange-500 to-rose-500 px-3 py-2.5 text-xs font-bold text-white shadow-lg shadow-orange-950/40 transition hover:-translate-y-0.5 hover:from-orange-400 hover:to-rose-400 focus:outline-none focus:ring-2 focus:ring-orange-300/60 active:translate-y-0"
      >
        <.icon name="hero-bolt" class="size-4" /> Engage
        <kbd class="rounded bg-black/20 px-1.5 py-0.5 font-mono text-[0.58rem]">Space</kbd>
      </button>
    </div>
  </aside>

  <nav
    id="action-hotbar"
    aria-label="Action hotbar"
    class="pointer-events-auto absolute bottom-3 left-1/2 z-20 w-[min(42rem,calc(100%-1rem))] -translate-x-1/2 sm:bottom-5"
  >
    <div class="mb-1.5 flex items-center justify-center gap-2 text-[0.52rem] font-semibold uppercase tracking-[0.24em] text-slate-500">
      <span>Action matrix</span>
      <span class="size-1 rounded-full bg-slate-700"></span>
      <span id="hotbar-mode" class="text-cyan-300/75">Standby</span>
    </div>
    <div class="grid grid-cols-10 gap-1 rounded-2xl border border-cyan-300/15 bg-slate-950/85 p-1.5 shadow-2xl shadow-black/50 backdrop-blur-xl sm:gap-1.5 sm:p-2">
      <%= for slot <- @action_hotbar do %>
        <button
          id={"hotbar-slot-#{slot.slot}"}
          type="button"
          data-hotbar-slot={slot.slot}
          data-action-id={slot.action && slot.action.id}
          aria-label={
            if slot.action,
              do: "Slot #{slot.key}: #{slot.action.label}",
              else: "Slot #{slot.key}: empty"
          }
          aria-pressed="false"
          class={[
            "hotbar-slot group relative aspect-square min-w-0 overflow-hidden rounded-lg border bg-slate-900/90 text-slate-500 transition duration-150 focus:outline-none focus:ring-2 focus:ring-cyan-300/60 active:scale-95 sm:rounded-xl",
            if(slot.action,
              do:
                "border-cyan-300/25 text-cyan-100 hover:-translate-y-0.5 hover:border-cyan-200/55",
              else: "hotbar-slot-empty border-slate-800/90 hover:border-slate-700"
            )
          ]}
        >
          <span
            data-hotbar-cooldown
            class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-0 bg-slate-950/75 transition-[height] duration-100"
          >
          </span>
          <span class="absolute left-1 top-0.5 z-20 font-mono text-[0.5rem] font-bold text-slate-500 sm:left-1.5 sm:top-1 sm:text-[0.58rem]">
            {slot.key}
          </span>
          <span class="relative z-20 grid h-full place-items-center">
            <%= if slot.action do %>
              <span class="grid size-5 place-items-center rounded-md bg-cyan-300/10 text-cyan-200 sm:size-8 sm:rounded-lg">
                <.icon name="hero-bolt" class="size-3.5 sm:size-5" />
              </span>
            <% else %>
              <span class="size-1 rounded-full bg-slate-700"></span>
            <% end %>
          </span>
          <span class="pointer-events-none absolute inset-x-1 bottom-0.5 z-20 hidden truncate text-[0.42rem] font-semibold text-cyan-100 sm:block">
            {if slot.action, do: slot.action.label, else: "Empty"}
          </span>
        </button>
      <% end %>
    </div>
  </nav>

  <aside
    id="ship-hud"
    class="pointer-events-none absolute bottom-28 left-4 z-10 w-[min(23rem,calc(100%-2rem))] rounded-2xl border border-cyan-300/15 bg-slate-950/80 p-4 shadow-2xl shadow-black/40 backdrop-blur-xl sm:bottom-32 sm:left-6 sm:p-5 2xl:bottom-6"
  >
    <div class="flex items-start justify-between gap-4 border-b border-slate-800/90 pb-4">
      <div>
        <p class="text-[0.6rem] font-semibold uppercase tracking-[0.28em] text-cyan-300/65">
          Active pilot
        </p>
        <h2 id="hud-pilot" class="mt-1.5 text-lg font-semibold tracking-tight text-white">
          Synchronizing…
        </h2>
        <p id="hud-ship" class="mt-0.5 text-xs text-slate-500">Awaiting ship telemetry</p>
      </div>
      <div class="rounded-lg border border-slate-700/80 bg-slate-900/70 px-2.5 py-1.5 text-right">
        <p class="text-[0.55rem] uppercase tracking-[0.2em] text-slate-500">Config</p>
        <p id="hud-config" class="mt-0.5 text-xs font-bold text-cyan-200">—</p>
      </div>
    </div>

    <div class="mt-4 space-y-3">
      <div>
        <div class="mb-1.5 flex items-center justify-between text-[0.65rem] font-semibold uppercase tracking-[0.15em]">
          <span class="text-emerald-300">Hull integrity</span>
          <span id="hud-hp" class="font-mono text-slate-300">—</span>
        </div>
        <div class="h-1.5 overflow-hidden rounded-full bg-slate-800">
          <div
            id="hud-hp-bar"
            class="h-full w-0 rounded-full bg-gradient-to-r from-emerald-500 to-emerald-300 shadow-[0_0_12px_rgba(110,231,183,0.45)] transition-[width] duration-500"
          >
          </div>
        </div>
      </div>
      <div>
        <div class="mb-1.5 flex items-center justify-between text-[0.65rem] font-semibold uppercase tracking-[0.15em]">
          <span class="text-sky-300">Shield matrix</span>
          <span id="hud-shields" class="font-mono text-slate-300">—</span>
        </div>
        <div class="h-1.5 overflow-hidden rounded-full bg-slate-800">
          <div
            id="hud-shield-bar"
            class="h-full w-0 rounded-full bg-gradient-to-r from-blue-500 to-cyan-300 shadow-[0_0_12px_rgba(34,211,238,0.45)] transition-[width] duration-500"
          >
          </div>
        </div>
      </div>
    </div>

    <dl class="mt-4 grid grid-cols-3 gap-2">
      <div class="rounded-xl border border-slate-800 bg-slate-900/55 p-2.5">
        <dt class="text-[0.55rem] uppercase tracking-[0.17em] text-slate-500">Speed</dt>
        <dd id="hud-speed" class="mt-1 font-mono text-xs font-semibold text-slate-200">—</dd>
      </div>
      <div class="col-span-2 rounded-xl border border-slate-800 bg-slate-900/55 p-2.5">
        <dt class="text-[0.55rem] uppercase tracking-[0.17em] text-slate-500">Coordinates</dt>
        <dd id="hud-coordinates" class="mt-1 font-mono text-xs font-semibold text-slate-200">
          — / —
        </dd>
      </div>
    </dl>

    <div class="mt-3 rounded-xl border border-slate-800 bg-slate-900/45 p-3">
      <p class="text-[0.55rem] uppercase tracking-[0.17em] text-slate-500">Active equipment</p>
      <p id="hud-equipment" class="mt-1.5 truncate text-xs text-slate-300">
        Synchronizing configuration…
      </p>
    </div>
  </aside>

  <div class="pointer-events-none absolute bottom-28 right-5 z-10 hidden rounded-xl border border-slate-700/70 bg-slate-950/70 px-3 py-2 text-[0.65rem] text-slate-400 backdrop-blur xl:block">
    Left-click hostile to target · Hold empty space to steer · Space to engage · Esc to clear
  </div>

  <div
    id="game-error"
    class="pointer-events-none absolute left-1/2 top-24 z-20 hidden -translate-x-1/2 rounded-xl border border-rose-400/25 bg-rose-950/85 px-5 py-3 text-sm text-rose-100 shadow-xl backdrop-blur"
  >
  </div>
</div>
