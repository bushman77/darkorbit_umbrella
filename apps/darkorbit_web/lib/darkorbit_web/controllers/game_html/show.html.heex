<div
  id="game-client"
  data-socket-token={@socket_token}
  data-map-id="1-1"
  data-display-mode="3d"
  data-layout-player-id={@layout_player_id}
  class="relative h-screen min-h-[38rem] overflow-hidden bg-[#02050c] text-slate-100"
>
  <%!-- Invisible pointer surface, not a 2D renderer. The atlas owns 2D navigation. --%>
  <div
    id="space-viewport"
    class="absolute inset-0 size-full cursor-crosshair touch-none focus:outline-none"
    tabindex="0"
    aria-label="3D space cockpit targeting. Press M for the Solar System Atlas."
  >
  </div>

  <canvas id="space-viewport-3d" class="pointer-events-none absolute inset-0 size-full" aria-hidden="true"></canvas>

  <%!-- Encounter decisions are authoritative and survive reconnection.
       SBS repeats each panel per eye to avoid an uncomfortable binocular overlay. --%>
  <section id="solar-encounter-panel" hidden role="dialog" aria-modal="true"
    aria-labelledby="solar-encounter-title" class="solar-encounter-modal">
    <div class="solar-encounter-eye">
      <div class="solar-encounter-card">
        <p class="solar-encounter-kicker">SOL / ENCOUNTER DETECTED</p>
        <p class="solar-encounter-hold">INTERPLANETARY CRUISE PAUSED</p>
        <h2 id="solar-encounter-title" data-encounter-title>Unidentified vessel</h2>
        <p data-encounter-distance class="solar-encounter-distance">Acquiring contact</p>
        <p class="solar-encounter-description">Hail this contact, or continue your original course.</p>
        <p data-encounter-message role="status" aria-live="polite" class="solar-encounter-message">Choose how to proceed.</p>
        <div class="solar-encounter-actions">
          <button type="button" data-encounter-action="hail" class="nav-button nav-primary">Hail vessel</button>
          <button type="button" data-encounter-action="continue" class="nav-button">Ignore / Resume course</button>
        </div>
        <p class="solar-encounter-note">Your ship is held at this location. Other traffic continues. Tactical combat and interception are future features.</p>
      </div>
    </div>
    <div class="solar-encounter-eye solar-encounter-eye-right" aria-hidden="true">
      <div class="solar-encounter-card">
        <p class="solar-encounter-kicker">SOL / ENCOUNTER DETECTED</p>
        <p class="solar-encounter-hold">INTERPLANETARY CRUISE PAUSED</p>
        <h2 data-encounter-title>Unidentified vessel</h2>
        <p data-encounter-distance class="solar-encounter-distance">Acquiring contact</p>
        <p class="solar-encounter-description">Hail this contact, or continue your original course.</p>
        <p data-encounter-message class="solar-encounter-message">Choose how to proceed.</p>
        <div class="solar-encounter-actions">
          <button type="button" data-encounter-action="hail" tabindex="-1" class="nav-button nav-primary">Hail vessel</button>
          <button type="button" data-encounter-action="continue" tabindex="-1" class="nav-button">Ignore / Resume course</button>
        </div>
        <p class="solar-encounter-note">Your ship is held at this location. Other traffic continues. Tactical combat and interception are future features.</p>
      </div>
    </div>
  </section>

  <p id="planetary-view-status" hidden
     class="pointer-events-none absolute left-6 top-24 z-20 max-w-[min(22rem,80vw)] rounded-lg border border-amber-200/25 bg-slate-950/75 px-3 py-2 font-mono text-[0.68rem] tracking-wider text-amber-100 backdrop-blur-sm">
    SOL / PLANETARY VIEW
  </p>

  <header class="pointer-events-none absolute inset-x-0 top-0 z-40 flex items-start justify-between gap-4 p-4 sm:p-6">
    <div class="pointer-events-auto flex items-center gap-3 rounded-2xl border border-cyan-300/15 bg-slate-950/75 px-4 py-3 shadow-xl shadow-black/30 backdrop-blur-xl">
      <div class="hidden size-9 place-items-center rounded-xl bg-cyan-300/10 text-cyan-200 sm:grid">
        <.icon name="hero-rocket-launch" class="size-5" />
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span
            id="connection-indicator"
            class="size-1.5 rounded-full bg-amber-300 shadow-[0_0_10px_rgba(252,211,77,0.8)]"
          >
          </span>
          <p
            id="connection-status"
            class="text-[0.62rem] font-semibold uppercase tracking-[0.25em] text-slate-400"
          >
            Connecting
          </p>
        </div>
        <p class="mt-1 text-sm font-semibold" id="propulsion-status">CONVENTIONAL FLIGHT</p>
      </div>
    </div>

    <div class="pointer-events-auto flex items-center gap-2 rounded-xl border border-cyan-300/15 bg-slate-950/85 px-3 py-2 backdrop-blur-xl">
      <span id="cockpit-helmet-status" aria-live="polite"
            class="text-[0.6rem] font-semibold tracking-wide text-cyan-200">HMD UNPAIRED</span>
      <label for="display-mode" class="text-[0.6rem] font-bold tracking-widest text-cyan-200">VIEW</label>
      <select id="display-mode" aria-label="Space display mode" class="rounded-md border border-slate-700 bg-slate-900 px-2 py-1 text-xs text-slate-100">
        <option value="3d" selected>3D cockpit</option>
        <option value="sbs">Stereo SBS</option>
      </select>
    </div>

    <%!-- Phone-only lens calibration; visible in cockpit when a headset
         reports actual rendered frames. Small buttons are a fallback when
         the keyboard cannot intercept the arrows. --%>
    <div id="cockpit-helmet-calibration" hidden
         class="pointer-events-auto absolute right-4 top-24 z-40 max-w-[min(24rem,92vw)] rounded-xl border border-cyan-400/40 bg-slate-950/95 px-3 py-3 text-xs text-cyan-100 shadow-xl">
      <p class="mb-2 font-bold tracking-wider text-cyan-200">HMD LENS CALIBRATION</p>
      <p id="cockpit-helmet-alignment" aria-live="polite" class="mb-2 font-mono text-cyan-200">
        HMD CALIBRATION
      </p>
      <div class="grid grid-cols-2 gap-2">
        <button type="button" data-helmet-axis="gap" data-helmet-direction="-1"
                class="rounded border border-slate-600 bg-slate-800 px-2 py-2 hover:border-cyan-300"
                title="Bring the left/right eye images closer (Left Arrow)">Closer [←]</button>
        <button type="button" data-helmet-axis="gap" data-helmet-direction="1"
                class="rounded border border-slate-600 bg-slate-800 px-2 py-2 hover:border-cyan-300"
                title="Move the left/right eye images farther apart (Right Arrow)">Farther [→]</button>
        <button type="button" data-helmet-axis="eye_sep" data-helmet-direction="-1"
                class="rounded border border-slate-600 bg-slate-800 px-2 py-2 hover:border-cyan-300"
                title="Decrease simulated eye separation (F6)">IPD − [F6]</button>
        <button type="button" data-helmet-axis="eye_sep" data-helmet-direction="1"
                class="rounded border border-slate-600 bg-slate-800 px-2 py-2 hover:border-cyan-300"
                title="Increase eye separation (Ctrl+F6)">IPD + [Ctrl+F6]</button>
      </div>
      <p id="cockpit-helmet-feedback" role="status" class="mt-2 text-amber-200"></p>
    </div>

    <button id="nav-open" type="button" class="pointer-events-auto rounded-xl border border-cyan-300/30 bg-slate-950/85 px-4 py-3 text-xs font-bold tracking-widest text-cyan-100 hover:border-cyan-300" aria-keyshortcuts="M">
      <.icon name="hero-map" class="mr-1 inline size-4" /> SOLAR ATLAS <span class="text-cyan-300/60">[M]</span>
    </button>

    <.form
      for={@logout_form}
      id="pilot-logout-form"
      action={~p"/logout"}
      method="delete"
      class="pointer-events-auto"
    >
      <button
        id="pilot-logout-button"
        type="submit"
        class="flex items-center gap-2 rounded-xl border border-slate-700/80 bg-slate-950/75 px-3.5 py-2.5 text-xs font-semibold text-slate-300 backdrop-blur-xl transition hover:border-rose-300/40 hover:text-rose-200 focus:outline-none focus:ring-2 focus:ring-rose-300/50"
      >
        <.icon name="hero-power" class="size-4" />
        <span class="hidden sm:inline">End session</span>
      </button>
    </.form>
  </header>

  <section id="navigation-computer" class="navigation-computer" role="dialog" aria-modal="true" aria-labelledby="nav-title">
    <div class="nav-shell">
      <div class="nav-heading">
        <div>
          <p class="nav-eyebrow">FLIGHT SYSTEMS // NAVIGATION DECK</p>
          <h2 id="nav-title">Solar System Atlas</h2>
          <p id="nav-subtitle" class="nav-subtitle">One star system · Sun, eight planets and Pluto · select a world to inspect.</p>
        </div>
        <button id="nav-helmet-open" class="nav-button" type="button" aria-controls="helmet-panel">
          PILOT HMD · <span id="nav-helmet-status">NOT PAIRED</span>
        </button>
        <button id="nav-close" class="nav-button nav-close" type="button" aria-label="Close navigation computer">Return to cockpit <span class="text-cyan-300">[M / Esc]</span></button>
      </div>
      <section id="helmet-panel" hidden aria-label="Pilot HMD management"
               class="mx-4 mb-4 rounded-xl border border-cyan-400/30 bg-slate-950 p-4 text-slate-100">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="font-bold tracking-wider text-cyan-200">PILOT HMD / HEADSET LINK</h3>
          <button id="nav-helmet-close" type="button" class="nav-button">Close panel</button>
        </div>
        <p id="helmet-device-status" class="my-3 text-sm text-slate-300">No helmet paired</p>
        <div id="helmet-unpaired">
          <div class="flex flex-wrap items-start gap-4">
            <canvas id="helmet-qr" width="220" height="220" class="rounded-lg bg-white"></canvas>
            <div class="max-w-md space-y-2 text-sm text-slate-300">
              <p>Scan once with your phone. The ship automatically authorizes it as a read-only SBS helmet.</p>
              <label for="helmet-host" class="block font-semibold text-cyan-100">Reachable laptop address</label>
              <input id="helmet-host" type="text" list="helmet-host-candidates"
                     class="w-full rounded border border-slate-600 bg-slate-900 p-2 text-white"
                     placeholder="http://192.168.1.100:4000" />
              <datalist id="helmet-host-candidates"></datalist>
              <p>The laptop's LAN IP is detected automatically. If you have multiple network interfaces,
                choose another suggested address or enter one manually. The phone must be able to reach this address.</p>
              <p id="helmet-pairing-message" role="status">Open this panel to generate a pairing invitation.</p>
            </div>
          </div>
        </div>
        <div id="helmet-paired" hidden class="space-y-3">
          <p class="text-sm text-cyan-100">This helmet is remembered across disconnects and server restarts.
            The phone displays black in the Atlas and renders SBS only in the combat cockpit.</p>
          <button id="helmet-forget" class="nav-button nav-danger" type="button">Forget headset</button>
        </div>
      </section>
      <%!-- Pilot control preferences are client-side; never part of combat authority. --%>
      <section aria-label="Cockpit control preferences"
               class="mx-4 mb-4 rounded-xl border border-cyan-400/25 bg-slate-950/80 p-3 text-slate-200">
        <div class="flex flex-wrap items-center gap-4">
          <label class="flex cursor-pointer items-center gap-2 text-sm font-semibold text-cyan-100">
            <input id="nav-mouse-steering" type="checkbox"
                   class="size-4 accent-cyan-400" />
            Enable mouse-look steering
          </label>
          <label for="nav-mouse-sensitivity" class="flex items-center gap-2 text-xs text-slate-300">
            Sensitivity
            <input id="nav-mouse-sensitivity" type="range" min="40" max="600"
                   step="10" value="100" class="w-32 accent-cyan-400" />
            <output id="nav-mouse-sensitivity-value" for="nav-mouse-sensitivity">1.0×</output>
          </label>
        </div>
        <p class="mt-2 text-xs text-slate-400">
          When enabled, return to the cockpit and click its background once to capture the mouse.
          Move the mouse to pitch and yaw. Esc releases the cursor; M opens Atlas.
          Keyboard steering, wheel throttle, Ctrl+wheel roll and right-click lasers remain available.
        </p>
      </section>

      <div class="atlas-view-tabs" role="tablist" aria-label="Atlas navigation level">
        <button id="nav-view-system" class="atlas-view-tab is-active" type="button"
          role="tab" aria-selected="true" aria-controls="nav-solar-view">
          <.icon name="hero-globe-alt" class="inline size-4" /> Solar System
        </button>
        <button id="nav-view-sector" class="atlas-view-tab" type="button"
          role="tab" aria-selected="false" aria-controls="nav-sector-view">
          <.icon name="hero-map" class="inline size-4" /> Sector 1-1
        </button>
        <span class="atlas-level-hint">SOL / ONE STAR SYSTEM</span>
      </div>

      <section id="nav-solar-view" class="solar-atlas-layout" role="tabpanel"
        aria-labelledby="nav-view-system">
        <div class="solar-atlas-frame">
          <div class="nav-map-caption">
            <span>SOLAR SYSTEM // ORBITAL OVERVIEW</span>
            <span>SCHEMATIC · NOT TO SCALE</span>
          </div>
          <svg id="nav-solar-chart" viewBox="0 0 1000 600"
            aria-label="Schematic solar system orbital chart. Select the Sun, a planet, or Pluto."
            role="group">
            <g id="nav-solar-content"></g>
          </svg>
          <div class="solar-chart-controls">
            <div class="solar-zoom-group" aria-label="Solar map view">
              <button class="solar-zoom-button is-active" data-solar-focus="system"
                aria-pressed="true" type="button">Full system</button>
              <button class="solar-zoom-button" data-solar-focus="inner"
                aria-pressed="false" type="button">Inner planets</button>
            </div>
            <p>Orbital distances are compressed for readability. Positions are illustrative, not live.</p>
          </div>
        </div>

        <aside class="solar-atlas-panel" aria-label="Solar system body details">
          <p class="nav-eyebrow">SOL / CELESTIAL CATALOG</p>
          <div class="solar-system-count">1 STAR · 8 PLANETS · PLUTO</div>
          <div id="nav-system-bodies" class="solar-body-list"
            aria-label="Select a celestial body"></div>
          <div class="solar-selected-body">
            <p class="nav-eyebrow">SELECTED BODY</p>
            <h3 id="nav-solar-name">Earth</h3>
            <p id="nav-solar-type">Planet</p>
            <dl class="solar-body-metrics">
              <div><dt>MEAN SOLAR DISTANCE</dt><dd id="nav-solar-distance">1 AU</dd></div>
              <div><dt>ORBITAL PERIOD</dt><dd id="nav-solar-period">1 Earth year</dd></div>
            </dl>
          </div>
          <div class="solar-navigation-console">
            <p class="nav-eyebrow">INTERPLANETARY NAVIGATION / SOL-01</p>
            <div id="nav-solar-state" class="nav-state">CONNECTING</div>
            <dl class="solar-body-metrics">
              <div><dt>CURRENT REGION</dt><dd id="nav-solar-location">—</dd></div>
              <div><dt>FLIGHT PLAN</dt><dd id="nav-solar-route">NO ACTIVE TRANSIT</dd></div>
              <div><dt>PROPULSION</dt><dd id="nav-solar-drive">CONVENTIONAL</dd></div>
              <div><dt>DRIVE SPEED</dt><dd id="nav-solar-speed">Conventional thrusters</dd></div>
              <div><dt>TRAVEL DISTANCE</dt><dd id="nav-solar-distance-travelled">No interplanetary course</dd></div>
              <div><dt>ARRIVAL ETA</dt><dd id="nav-solar-eta">—</dd></div>
            </dl>
            <label for="nav-solar-progress" id="nav-solar-progress-label" class="solar-progress-label">
              Ready to plot course
            </label>
            <progress id="nav-solar-progress" max="100" value="0"></progress>
            <button id="nav-solar-engage" type="button" class="nav-button nav-primary">
              Set course to Earth
            </button>
            <button id="nav-solar-cancel" type="button" class="nav-button nav-danger" disabled>
              Abort transit
            </button>
          </div>
          <section class="mt-4 rounded-lg border border-cyan-500/25 bg-slate-950/70 p-3"
                   aria-label="Strategic traffic contacts">
            <p class="nav-eyebrow">SENSOR TRAFFIC / LIVE CONTACTS</p>
            <p class="my-2 text-xs text-slate-300">
              Vessels follow their own routes. Contacts appear only within sensor range.
            </p>
            <div id="nav-traffic-contacts" class="space-y-2 text-xs text-cyan-100"
                 aria-live="polite">No contacts in range.</div>
            <p id="nav-traffic-comms" class="mt-3 whitespace-pre-line text-xs text-emerald-200"
               role="status">Select Hail when a vessel is in range.</p>
          </section>
          <p class="solar-system-note">Interplanetary cruise uses a dedicated sublight
            drive and the same real-time clock as combat. Distance is compressed
            into game kilometers, not physical Solar System kilometers. Cockpit
            controls and weapons are locked during cruise. This is system-level
            travel only: orbital physics and physical sector transfers are not yet
            connected.</p>
        </aside>
      </section>

      <section id="nav-sector-view" role="tabpanel" aria-labelledby="nav-view-sector" hidden>
      <div class="nav-layout">
        <div class="nav-map-frame">
          <div class="nav-map-caption"><span>SECTOR ATLAS // XY PROJECTION</span><span>CLICK TO ADD WAYPOINT</span></div>
          <svg id="nav-chart" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Sector overview map. Click to add a waypoint to a draft flight route.">
            <defs>
              <pattern id="nav-grid-pattern" x="0" y="0" width="50" height="50" patternUnits="userSpaceOnUse">
                <path d="M 50 0 L 0 0 0 50" fill="none" stroke="#16384f" stroke-width="1"/>
              </pattern>
            </defs>
            <rect x="0" y="0" width="1000" height="600" fill="#061321"/>
            <rect x="0" y="0" width="1000" height="600" fill="url(#nav-grid-pattern)"/>
            <g id="nav-chart-content"></g>
          </svg>
          <div class="nav-legend"><span><i class="nav-key-self"></i>YOUR SHIP</span><span><i class="nav-key-ally"></i>PILOTS</span><span><i class="nav-key-npc"></i>HOSTILES</span><span><i class="nav-key-route"></i>ROUTE</span></div>
        </div>
        <aside class="nav-console">
          <p class="nav-eyebrow">FLIGHT COMPUTER / NAV-01</p>
          <div id="nav-state" class="nav-state">HELM IDLE</div>
          <dl class="nav-metrics">
            <div><dt>SHIP POSITION</dt><dd id="nav-position">— / —</dd></div>
            <div><dt>ROUTE LENGTH</dt><dd id="nav-distance">0 units</dd></div>
          </dl>
          <div class="nav-console-heading"><h3>COURSE WAYPOINTS</h3><span id="nav-waypoint-count">0 / 8</span></div>
          <ol id="nav-waypoints" class="nav-waypoints" aria-label="Plotted waypoint coordinates"></ol>
          <form id="nav-coordinate-form" class="nav-coordinate-form">
            <label>X <input id="nav-x" type="number" min="0" max="20000" step="any" placeholder="X" required /></label>
            <label>Y <input id="nav-y" type="number" min="0" max="12000" step="any" placeholder="Y" required /></label>
            <label class="nav-altitude-label">Z ALTITUDE <input id="nav-z" type="number" min="-3000" max="3000" step="any" value="0" placeholder="Altitude" required /></label>
            <button class="nav-button" type="submit">Add coordinates</button>
          </form>
          <div class="nav-console-actions">
            <button id="nav-engage" class="nav-button nav-primary" type="button">Engage autopilot</button>
            <button id="nav-stop" class="nav-button nav-danger" type="button">Stop / cancel course</button>
            <div class="nav-secondary-actions">
              <button id="nav-undo" class="nav-button" type="button">Undo point</button>
              <button id="nav-clear" class="nav-button" type="button">Clear draft</button>
            </div>
          </div>
          <p id="nav-message" class="nav-message" role="status" aria-live="polite">Awaiting navigation data.</p>
          <p class="nav-subtitle">Atlas projects XY overhead; Z sets the waypoint altitude. M returns to your single 3D or SBS cockpit.</p>
        </aside>
      </div>
      </section>
    </div>
  </section>

  <div id="cockpit-interface" class="cockpit-interface" aria-label="Customizable cockpit HUD">
    <div id="cockpit-window-stage" class="cockpit-window-stage">
      <section
        id="cockpit-window-ship-status"
        data-cockpit-window="ship_status"
        class="cockpit-window cockpit-window-ship"
        aria-labelledby="ship-status-title"
      >
        <header
          id="ship-status-drag-handle"
          data-cockpit-drag-handle
          class="cockpit-window-header"
          tabindex="0"
          aria-label="Ship status window drag handle. Use arrow keys while the HUD is unlocked to move this window."
        >
          <div class="flex min-w-0 items-center gap-2.5">
            <span class="cockpit-window-mark">
              <.icon name="hero-rocket-launch" class="size-3.5" />
            </span>
            <div class="min-w-0">
              <p class="cockpit-window-kicker">Flight telemetry</p>
              <h2 id="ship-status-title" class="cockpit-window-title">Ship status</h2>
            </div>
          </div>
          <div data-cockpit-collapsed-summary class="cockpit-collapsed-summary">
            <span class="text-emerald-300">H <strong id="hud-compact-hp">—</strong></span>
            <span class="text-sky-300">S <strong id="hud-compact-shields">—</strong></span>
          </div>
          <div class="cockpit-window-actions">
            <button
              id="ship-status-hide"
              data-cockpit-hide
              type="button"
              class="cockpit-window-button cockpit-edit-control"
              aria-label="Hide ship status"
            >
              <.icon name="hero-eye-slash" class="size-3.5" />
            </button>
            <button
              id="ship-status-collapse"
              data-cockpit-collapse
              type="button"
              class="cockpit-window-button"
              aria-label="Collapse ship status"
              aria-expanded="true"
            >
              <.icon name="hero-chevron-up" class="cockpit-collapse-open size-3.5" />
              <.icon name="hero-chevron-down" class="cockpit-collapse-closed size-3.5" />
            </button>
          </div>
        </header>

        <div data-cockpit-content class="cockpit-window-content">
          <div class="flex items-start justify-between gap-4 border-b border-slate-800/90 pb-4">
            <div class="min-w-0">
              <p class="text-[0.58rem] font-semibold uppercase tracking-[0.24em] text-cyan-300/65">
                Active pilot
              </p>
              <p
                id="hud-pilot"
                class="mt-1.5 truncate text-lg font-semibold tracking-tight text-white"
              >
                Synchronizing…
              </p>
              <p id="hud-ship" class="mt-0.5 truncate text-xs text-slate-500">
                Awaiting ship telemetry
              </p>
            </div>
            <div class="rounded-lg border border-slate-700/80 bg-slate-900/70 px-2.5 py-1.5 text-right">
              <p class="text-[0.52rem] uppercase tracking-[0.2em] text-slate-500">Config</p>
              <p id="hud-config" class="mt-0.5 text-xs font-bold text-cyan-200">—</p>
            </div>
          </div>

          <div class="mt-4 space-y-3">
            <div>
              <div class="mb-1.5 flex items-center justify-between text-[0.62rem] font-semibold uppercase tracking-[0.13em]">
                <span class="text-emerald-300">Hull integrity</span>
                <span id="hud-hp" class="font-mono text-slate-300">—</span>
              </div>
              <div class="h-1.5 overflow-hidden rounded-full bg-slate-800">
                <div id="hud-hp-bar" class="cockpit-health-bar cockpit-health-bar-hull"></div>
              </div>
            </div>
            <div>
              <div class="mb-1.5 flex items-center justify-between text-[0.62rem] font-semibold uppercase tracking-[0.13em]">
                <span class="text-sky-300">Shield matrix</span>
                <span id="hud-shields" class="font-mono text-slate-300">—</span>
              </div>
              <div class="h-1.5 overflow-hidden rounded-full bg-slate-800">
                <div id="hud-shield-bar" class="cockpit-health-bar cockpit-health-bar-shield">
                </div>
              </div>
            </div>
          </div>

          <dl class="mt-4 grid grid-cols-3 gap-2">
            <div class="cockpit-metric">
              <dt>Speed</dt>
              <dd id="hud-speed">—</dd>
            </div>
            <div class="cockpit-metric col-span-2">
              <dt>Coordinates</dt>
              <dd id="hud-coordinates">— / —</dd>
            </div>
          </dl>

          <div class="mt-3 rounded-xl border border-slate-800 bg-slate-900/45 p-3">
            <p class="text-[0.52rem] uppercase tracking-[0.17em] text-slate-500">
              Active equipment
            </p>
            <p id="hud-equipment" class="mt-1.5 truncate text-xs text-slate-300">
              Synchronizing configuration…
            </p>
          </div>
        </div>
      </section>

      <section
        id="cockpit-window-minimap"
        data-cockpit-window="minimap"
        class="cockpit-window cockpit-window-minimap"
        aria-labelledby="minimap-title"
      >
        <header
          id="minimap-drag-handle"
          data-cockpit-drag-handle
          class="cockpit-window-header"
          tabindex="0"
          aria-label="Minimap window drag handle. Use arrow keys while the HUD is unlocked to move this window."
        >
          <div class="flex min-w-0 items-center gap-2.5">
            <span class="cockpit-window-mark"><.icon name="hero-map" class="size-3.5" /></span>
            <div class="min-w-0">
              <p class="cockpit-window-kicker">Sector 1-1</p>
              <h2 id="minimap-title" class="cockpit-window-title">Minimap</h2>
            </div>
          </div>
          <div data-cockpit-collapsed-summary class="cockpit-collapsed-summary">
            <span>Boundary online</span>
          </div>
          <div class="cockpit-window-actions">
            <div class="cockpit-minimap-size-controls" role="group" aria-label="Minimap size">
              <button
                id="minimap-decrease"
                data-cockpit-minimap-resize="decrease"
                type="button"
                class="cockpit-window-button cockpit-minimap-size-button"
                aria-label="Decrease minimap width"
              >
                −
              </button>
              <button
                id="minimap-increase"
                data-cockpit-minimap-resize="increase"
                type="button"
                class="cockpit-window-button cockpit-minimap-size-button"
                aria-label="Increase minimap width"
              >
                +
              </button>
            </div>
            <button
              id="minimap-hide"
              data-cockpit-hide
              type="button"
              class="cockpit-window-button cockpit-edit-control"
              aria-label="Hide minimap"
            >
              <.icon name="hero-eye-slash" class="size-3.5" />
            </button>
            <button
              id="minimap-collapse"
              data-cockpit-collapse
              type="button"
              class="cockpit-window-button"
              aria-label="Collapse minimap"
              aria-expanded="true"
            >
              <.icon name="hero-chevron-up" class="cockpit-collapse-open size-3.5" />
              <.icon name="hero-chevron-down" class="cockpit-collapse-closed size-3.5" />
            </button>
          </div>
        </header>

        <div data-cockpit-content class="cockpit-minimap-content">
          <canvas
            id="cockpit-minimap-canvas"
            class="block aspect-[5/3] w-full"
            aria-label="Interactive sector minimap. Left-click within the sector boundary to set a server-authoritative travel destination."
            aria-describedby="minimap-navigation-status"
          >
            Your browser needs Canvas 2D support to display the minimap.
          </canvas>
          <div class="cockpit-minimap-legend" aria-hidden="true">
            <span><i class="bg-cyan-300"></i>You</span>
            <span><i class="bg-violet-300"></i>Pilots</span>
            <span><i class="bg-orange-400"></i>Hostiles</span>
            <span><i class="cockpit-minimap-destination-key"></i>Course</span>
          </div>
          <p id="minimap-navigation-status" class="cockpit-minimap-status" aria-live="polite">
            Awaiting sector link
          </p>
        </div>
      </section>
    </div>

    <aside id="cockpit-settings" class="cockpit-settings" aria-label="Cockpit layout settings">
      <button
        id="cockpit-lock-toggle"
        data-cockpit-lock-toggle
        type="button"
        class="cockpit-settings-button"
        aria-label="Unlock HUD"
        aria-pressed="false"
      >
        <.icon name="hero-lock-closed" class="cockpit-lock-locked size-4" />
        <.icon name="hero-lock-open" class="cockpit-lock-unlocked size-4" />
        <span data-cockpit-lock-label class="hidden sm:inline">Unlock HUD</span>
      </button>
      <button
        id="cockpit-menu-toggle"
        data-cockpit-menu-toggle
        type="button"
        class="cockpit-settings-icon-button"
        aria-label="Open cockpit window menu"
        aria-controls="cockpit-window-menu"
        aria-expanded="false"
      >
        <.icon name="hero-adjustments-horizontal" class="size-4" />
      </button>

      <div id="cockpit-window-menu" data-cockpit-menu class="cockpit-settings-menu" hidden>
        <div class="border-b border-slate-800/90 px-3.5 py-3">
          <p class="text-[0.55rem] font-semibold uppercase tracking-[0.22em] text-cyan-300/65">
            Cockpit windows
          </p>
          <p class="mt-1 text-[0.65rem] text-slate-500">Show, hide, or restore HUD panels.</p>
        </div>
        <div class="space-y-1 p-2">
          <button
            id="cockpit-visibility-ship"
            data-cockpit-visibility="ship_status"
            type="button"
            class="cockpit-visibility-button"
          >
            <span><.icon name="hero-rocket-launch" class="size-3.5" /> Ship status</span>
            <small data-cockpit-visibility-status>Visible</small>
          </button>
          <button
            id="cockpit-visibility-minimap"
            data-cockpit-visibility="minimap"
            type="button"
            class="cockpit-visibility-button"
          >
            <span><.icon name="hero-map" class="size-3.5" /> Minimap</span>
            <small data-cockpit-visibility-status>Visible</small>
          </button>
        </div>
        <div class="border-t border-slate-800/90 p-2">
          <button
            id="cockpit-reset-layout"
            data-cockpit-reset
            type="button"
            class="cockpit-reset-button"
          >
            <.icon name="hero-arrow-path" class="size-3.5" /> Reset layout
          </button>
        </div>
      </div>
    </aside>
  </div>

  <nav
    id="action-hotbar"
    aria-label="Action hotbar"
    class="pointer-events-auto absolute bottom-3 left-1/2 z-40 w-[min(42rem,calc(100%-1rem))] -translate-x-1/2 sm:bottom-5"
  >
    <div class="mb-1.5 flex items-center justify-center gap-2 text-[0.52rem] font-semibold uppercase tracking-[0.24em] text-slate-500">
      <span>Action matrix</span>
      <span class="size-1 rounded-full bg-slate-700"></span>
      <span id="hotbar-mode" class="text-cyan-300/75">Standby</span>
    </div>
    <div class="grid grid-cols-10 gap-1 rounded-2xl border border-cyan-300/15 bg-slate-950/85 p-1.5 shadow-2xl shadow-black/50 backdrop-blur-xl sm:gap-1.5 sm:p-2">
      <%= for slot <- @action_hotbar do %>
        <button
          id={"hotbar-slot-#{slot.slot}"}
          type="button"
          data-hotbar-slot={slot.slot}
          data-action-id={slot.action && slot.action.id}
          data-action-type={slot.action && slot.action.type}
          data-activation-mode={slot.action && slot.action.activation_mode}
          aria-label={
            if slot.action,
              do: "Slot #{slot.key}: #{slot.action.label}",
              else: "Slot #{slot.key}: empty"
          }
          aria-pressed="false"
          class={[
            "hotbar-slot group relative aspect-square min-w-0 overflow-hidden rounded-lg border bg-slate-900/90 text-slate-500 transition duration-150 focus:outline-none focus:ring-2 focus:ring-cyan-300/60 active:scale-95 sm:rounded-xl",
            if(slot.action,
              do:
                "border-cyan-300/25 text-cyan-100 hover:-translate-y-0.5 hover:border-cyan-200/55",
              else: "hotbar-slot-empty border-slate-800/90 hover:border-slate-700"
            )
          ]}
        >
          <span
            data-hotbar-cooldown
            class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-0 bg-slate-950/75 transition-[height] duration-100"
          >
          </span>
          <span class="absolute left-1 top-0.5 z-20 font-mono text-[0.5rem] font-bold text-slate-500 sm:left-1.5 sm:top-1 sm:text-[0.58rem]">
            {slot.key}
          </span>
          <span class="relative z-20 grid h-full place-items-center">
            <%= if slot.action do %>
              <span class="grid size-5 place-items-center rounded-md bg-cyan-300/10 text-cyan-200 sm:size-8 sm:rounded-lg">
                <.icon name="hero-bolt" class="size-3.5 sm:size-5" />
              </span>
            <% else %>
              <span class="size-1 rounded-full bg-slate-700"></span>
            <% end %>
          </span>
          <span class="pointer-events-none absolute inset-x-1 bottom-0.5 z-20 hidden truncate text-[0.42rem] font-semibold text-cyan-100 sm:block">
            {if slot.action, do: slot.action.label, else: "Empty"}
          </span>
        </button>
      <% end %>
    </div>
  </nav>

  <%!-- A prominent but non-interactive 3D-only confirmation near the crosshair.
       Stereo uses the in-world holographic HUD instead of a flat overlay. --%>
  <div id="laser-hit-confirmation" aria-live="polite"
    class="pointer-events-none absolute left-1/2 top-[39%] z-30 hidden -translate-x-1/2 rounded-lg border border-transparent bg-slate-950/85 px-4 py-2 text-center font-mono text-sm font-bold tracking-wider shadow-lg backdrop-blur-sm">
  </div>

  <%!-- Authoritative proximity status. Live text is announced only when the
       warning level changes; clearance updates are visual to avoid speech spam. --%>
  <div id="planetary-proximity-warning" hidden data-level="clear"
       class="pointer-events-none absolute left-1/2 top-[18%] z-40 w-max max-w-[min(28rem,90vw)] -translate-x-1/2 rounded-xl border border-amber-400/60 bg-amber-950/85 px-4 py-3 text-center font-mono shadow-lg backdrop-blur-sm">
    <p id="planetary-proximity-level" class="text-sm font-black tracking-widest text-amber-100">
      CAUTION · PLANETARY PROXIMITY
    </p>
    <p id="planetary-proximity-detail" class="mt-1 text-xs font-semibold tracking-wider text-amber-200">
      Maintain safe distance
    </p>
  </div>
  <p id="planetary-proximity-announcement" role="status" aria-live="polite"
     class="sr-only"></p>

  <p id="combat-status" role="status" aria-live="polite"
     class="pointer-events-none absolute bottom-24 left-4 z-30 max-w-[min(22rem,40vw)] font-mono text-xs text-rose-200 drop-shadow-md">
    RMB red laser · T nearest target · L autofire
  </p>

  <div id="flight-indicators" class="pointer-events-none absolute bottom-32 right-3 z-30 hidden rounded-lg border border-cyan-400/20 bg-slate-950/80 px-3 py-2 font-mono text-xs text-cyan-100 backdrop-blur sm:block">
    FLIGHT <span id="hud-flight-mode" class="text-cyan-300">CRUISE</span>
    · THR <span id="hud-throttle">0%</span>
    · SPEED <span id="hud-actual-speed">0 u/s</span>
    <div class="mt-1 text-cyan-200/80">
      HDG <span id="hud-heading">0°</span>
      · PITCH <span id="hud-pitch">0°</span> (<span id="hud-pitch-input">—</span>)
      · ROLL <span id="hud-roll">0°</span>
    </div>
    <div class="mt-1 text-cyan-200/80">
      TURN RATE P/Y/R <span id="hud-turn-rates">0 / 0 / 0 °/s</span>
    </div>
  </div>

  <p id="cockpit-mouse-steering-status" hidden aria-live="polite"
     class="pointer-events-none absolute bottom-44 left-1/2 z-30 -translate-x-1/2 rounded-lg border border-cyan-400/30 bg-slate-950/85 px-3 py-2 text-center font-mono text-xs text-cyan-200">
    MOUSE STEERING ENABLED · CLICK COCKPIT TO CAPTURE
  </p>

  <div id="game-controls-hint" class="pointer-events-none absolute bottom-28 left-1/2 z-10 hidden -translate-x-1/2 rounded-xl border border-slate-700/70 bg-slate-950/70 px-3 py-2 text-[0.65rem] text-slate-400 backdrop-blur xl:block">
    W/S pitch · A/D yaw · optional mouse-look (Atlas setting) · Ctrl+wheel roll · wheel throttle · Q/E roll · RMB laser · T target · M atlas
  </div>

  <div
    id="game-error"
    class="pointer-events-none absolute left-1/2 top-24 z-[70] hidden -translate-x-1/2 rounded-xl border border-rose-400/25 bg-rose-950/85 px-5 py-3 text-sm text-rose-100 shadow-xl backdrop-blur"
  >
  </div>
</div>
