<div id="pilot-resend-page" class="hud-screen hud-auth-screen">
  <div class="hud-auth-ambient" aria-hidden="true"></div>
  <main class="hud-auth-panel mx-auto my-16 w-full max-w-lg rounded-2xl border border-cyan-300/20 bg-slate-950/85 p-8 text-slate-100">
    <p class="text-xs font-bold uppercase tracking-widest text-cyan-300">SPACE NOVA / ACCOUNT RECOVERY</p>
    <h1 class="mt-4 text-3xl font-black">Resend confirmation</h1>
    <p class="mt-4 text-sm leading-7 text-slate-300">Enter the email address used when you registered. If your pilot is still awaiting verification, we'll send a fresh link when eligible. Links expire after 24 hours.</p>
    <p :if={!@registration_enabled} id="resend-closed" class="mt-6 text-sm text-amber-200">Email delivery is not configured on this server yet.</p>
    <.form :if={@registration_enabled} for={@form} id="pilot-resend-form" action={~p"/register/resend"} method="post" class="mt-7 space-y-5">
      <.input field={@form[:email]} type="email" label="Account email" autocomplete="email" required maxlength="260" class="hud-field mt-2 w-full rounded-xl border border-slate-700 bg-slate-900/90 px-4 py-3 text-sm text-white" />
      <button type="submit" id="pilot-resend-button" class="hud-cta w-full rounded-xl bg-cyan-300 px-5 py-3 text-sm font-bold text-slate-950">Request new link</button>
    </.form>
    <p class="mt-6 text-xs text-slate-400">Requests are limited to one per minute and five per 24 hours per unverified account. An email address will not be disclosed as registered or unregistered.</p>
    <.link href={~p"/login"} class="mt-7 inline-block text-sm font-bold text-cyan-200">Back to pilot sign in</.link>
  </main>
</div>
