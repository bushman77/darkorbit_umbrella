<div id="registration-success" class="relative flex min-h-screen items-center justify-center overflow-hidden bg-[#030914] px-6 py-12 text-slate-100">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_25%,rgba(34,211,238,0.17),transparent_45%)]"></div>
  <main class="relative w-full max-w-lg rounded-3xl border border-cyan-300/20 bg-slate-950/85 p-8 text-center shadow-2xl sm:p-12">
    <div class="mx-auto grid size-16 place-items-center rounded-2xl border border-cyan-300/25 bg-cyan-300/10">
      <.icon name="hero-envelope" class="size-8 text-cyan-300" />
    </div>
    <p class="mt-7 text-xs font-bold uppercase tracking-[0.25em] text-cyan-300">SPACE NOVA / PILOT RECRUITMENT</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-white">Check your inbox.</h1>
    <p class="mt-5 text-sm leading-7 text-slate-300">If the confirmation email was delivered, follow its verification link to activate your new pilot account. You cannot sign in until verification is complete.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <.link href={~p"/login"} class="rounded-xl bg-cyan-300 px-5 py-3 text-sm font-bold text-slate-950 transition hover:bg-cyan-200">Pilot sign in</.link>
      <.link href={~p"/"} class="rounded-xl border border-slate-600 px-5 py-3 text-sm font-bold text-slate-100 transition hover:border-cyan-300">Back to Space Nova</.link>
    </div>
  </main>
</div>
