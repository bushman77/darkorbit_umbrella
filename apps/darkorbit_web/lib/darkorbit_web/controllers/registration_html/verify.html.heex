<div id="pilot-verification-page" class="hud-screen hud-auth-screen">
  <div class="hud-auth-ambient" aria-hidden="true"></div>
  <main class="hud-auth-panel mx-auto my-16 w-full max-w-lg rounded-2xl border border-cyan-300/20 bg-slate-950/85 p-8 text-slate-100">
    <p class="text-xs font-bold uppercase tracking-widest text-cyan-300">SPACE NOVA / ACCOUNT VERIFICATION</p>
    <h1 class="mt-4 text-3xl font-black">Activate your pilot</h1>
    <p class="mt-4 text-sm leading-7 text-slate-300">Confirm that you want to activate the pilot account associated with this email. This action uses the single-use verification link.</p>
    <.form for={@form} id="pilot-verification-form" action={~p"/verify-account"} method="post" class="mt-7">
      <.input field={@form[:id]} type="hidden" />
      <.input field={@form[:token]} type="hidden" />
      <button id="pilot-confirm-button" type="submit" class="hud-cta w-full rounded-xl bg-cyan-300 px-5 py-3 text-sm font-bold text-slate-950">Confirm email and activate</button>
    </.form>
    <.link href={~p"/register/resend"} class="mt-7 inline-block text-sm font-bold text-cyan-200">Need a new verification link?</.link>
  </main>
</div>
