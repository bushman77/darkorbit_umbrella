<div id="helmet-client" data-pair-code={@pairing_code}
     class="fixed inset-0 z-50 overflow-hidden bg-black text-white">
  <canvas id="helmet-viewport" class="absolute inset-0 h-full w-full" hidden></canvas>
  <div id="helmet-message"
       class="absolute inset-x-0 top-1/2 mx-auto max-w-sm -translate-y-1/2 px-6 text-center text-sm text-cyan-100"
       role="status">Connecting to your pilot helmet…</div>
  <button id="helmet-fullscreen" type="button"
          class="absolute inset-0 z-20 h-full w-full cursor-pointer bg-transparent"
          aria-label="Tap to enter headset fullscreen mode">
  </button>
</div>
