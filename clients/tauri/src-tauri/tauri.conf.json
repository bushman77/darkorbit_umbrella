{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Space Nova",
  "version": "0.3.0",
  "identifier": "game.sbs.space",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Space Nova",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none';",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/128x128.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4N0JBRjU3RTZEMTdBQjMKUldTemV0SG1WNjk3V0tKOUE5WHFxSGVJQkxHNlFXelVqM2tQQkFnN01ZUjI4R0s4MlpkL0VyTWMK",
      "endpoints": [
        "https://github.com/bushman77/darkorbit_umbrella/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
