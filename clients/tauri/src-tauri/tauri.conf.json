{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Space Nova",
  "version": "0.3.1",
  "identifier": "game.sbs.space",
  "build": {
    "frontendDist": "../dist/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Space Nova",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https: wss: http://127.0.0.1:4000 ws://127.0.0.1:4000 http://localhost:4000 ws://localhost:4000; object-src 'none'; base-uri 'none';",
      "capabilities": [
        {
          "identifier": "local-networking-settings",
          "description": "Only bundled Space Nova launcher pages may manage native proxy preferences.",
          "windows": [
            "main"
          ],
          "local": true,
          "permissions": [
            "allow-get-network-settings",
            "allow-save-network-settings",
            "allow-restart-client"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/128x128.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4N0JBRjU3RTZEMTdBQjMKUldTemV0SG1WNjk3V0tKOUE5WHFxSGVJQkxHNlFXelVqM2tQQkFnN01ZUjI4R0s4MlpkL0VyTWMK",
      "endpoints": [
        "https://github.com/bushman77/darkorbit_umbrella/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
