{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SBS Space",
  "version": "0.1.0",
  "identifier": "game.sbs.space",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SBS Space",
        "url": "index.html",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none';",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/128x128.png"]
  }
}
