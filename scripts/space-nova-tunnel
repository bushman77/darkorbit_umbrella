#!/usr/bin/env bash
# Launch the INSTALLED production Space Nova client through a verified SSH SOCKS5 tunnel.
# Never disables TLS validation, modifies system proxy settings, or runs Tauri dev mode.
set -euo pipefail

proxy="socks5h://127.0.0.1:1080"
ssh_pid=""
key="${SPACE_NOVA_SSH_KEY:-$HOME/Downloads/space-mmo-dev.pem}"
remote="${SPACE_NOVA_SSH_HOST:-ubuntu@54.200.202.235}"

cleanup() {
  if [[ -n "$ssh_pid" ]]; then
    kill "$ssh_pid" 2>/dev/null || true
    wait "$ssh_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT

verify_tunnel() {
  curl --fail --silent --show-error --head \
    --proxy "$proxy" --noproxy '' --max-time 10 \
    https://spacenova.ddns.net/login >/dev/null 2>&1
}

if ! verify_tunnel; then
  [[ -r "$key" ]] || { echo "SSH key not readable: $key" >&2; exit 1; }
  echo "Opening Space Nova SSH SOCKS5 tunnel..."
  ssh -N -D 127.0.0.1:1080 \
    -o BatchMode=yes \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -i "$key" "$remote" &
  ssh_pid=$!

  ready=0
  for _ in {1..15}; do
    if ! kill -0 "$ssh_pid" 2>/dev/null; then
      echo "SSH tunnel exited before becoming usable." >&2
      exit 1
    fi
    if verify_tunnel; then ready=1; break; fi
    sleep 1
  done

  [[ "$ready" == 1 ]] || { echo "Verified TLS access through the tunnel failed." >&2; exit 1; }
else
  echo "Reusing existing verified SOCKS5 tunnel on 127.0.0.1:1080."
fi

client="$(command -v space-nova-client || true)"
[[ -n "$client" && -x "$client" ]] || {
  echo "Installed Space Nova client not found. Install the new production .deb first." >&2
  exit 1
}

echo "TLS verified. Launching installed Space Nova with native SOCKS5 proxy..."
echo "The game connects to https://spacenova.ddns.net using the SSH tunnel."
SPACE_NOVA_USE_SOCKS_TUNNEL=1 "$client"
